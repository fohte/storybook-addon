{
  "name": "@fohte/storybook-addon",
  "description": "@fohte's personal Storybook addons",
  "license": "MIT",
  "author": "Hayato Kawai <fohte.hk@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fohte/storybook-addon.git"
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "exports": {
    "./preview": {
      "types": "./lib/preview.d.ts",
      "default": "./lib/preview.js"
    },
    "./vitest-plugin": {
      "types": "./lib/vitest-plugin.d.ts",
      "default": "./lib/vitest-plugin.js"
    }
  },
  "imports": {
    "#*.js": "./lib/*.js"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "!lib/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "prebuild": "pnpm run clean",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm run lint && pnpm run build",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "pretest:unit": "pnpm run build",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@storybook/addon-vitest": "^10.0.0",
    "@storycap-testrun/browser": "^3.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "storybook": "^10.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@storybook/addon-vitest": {
      "optional": true
    },
    "@storycap-testrun/browser": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.4.4",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@storycap-testrun/browser": "3.1.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "@vitest/browser-playwright": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "version": "0.1.9"
}
